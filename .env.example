# HYPERION Environment Configuration Example
# Copy this file to .env or set environment variables in your deployment environment.

# Database path (default: backend/database/api_security.db)
HYPERION_DATABASE_PATH=backend/database/api_security.db

# Optional Gateway Administrator Secret (required for privileged gateway policy updates)
HYPERION_GATEWAY_ADMIN_SECRET=hyperion-local-dev-secret-change-me

# Optional Local LLM Integration (Ollama)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3

# Frontend API Base URL (for frontend/.env)
VITE_API_BASE=http://localhost:8000
